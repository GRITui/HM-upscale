#!/usr/bin/env bash
# Blocks commits that could leak copyrighted game data.
set -euo pipefail
root=$(git rev-parse --show-toplevel)
if git diff --cached --name-only --diff-filter=ACM | "$root/tools/hooks/check-paths.sh"; then
  exit 0
fi
echo "Commit rejected: see README 'No game data in this repo'."
exit 1
