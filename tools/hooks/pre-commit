#!/usr/bin/env bash
# Blocks commits that could leak copyrighted game data.
set -euo pipefail
MAX_BYTES=$((5 * 1024 * 1024))
BAD_EXT='\.(iso|chd|cso|pbp|bin|hdt|prx|sfo|at3|at9|pmf|gim|pak)$'
fail=0
while IFS= read -r f; do
  [ -f "$f" ] || continue
  if echo "$f" | grep -Eiq "$BAD_EXT|^assets/|EBOOT"; then
    echo "BLOCKED (game-data path/extension): $f"; fail=1; continue
  fi
  sz=$(wc -c < "$f")
  if [ "$sz" -gt "$MAX_BYTES" ]; then
    echo "BLOCKED (>5 MB): $f ($sz bytes)"; fail=1
  fi
done < <(git diff --cached --name-only --diff-filter=ACM)
[ "$fail" -eq 0 ] || { echo "Commit rejected: see README 'No game data in this repo'."; exit 1; }
